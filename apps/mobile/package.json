    "@cave-notes/platform": "0.1.0",
    "@cave-notes/service": "0.1.0",
    "@sqlite.org/sqlite-wasm": "*",
    "preact": "*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "esbuild": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "license": "MIT"
}
