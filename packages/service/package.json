{
  "name": "@cave-notes/service",
  "version": "0.1.0",
  "description": "The Cave Notes workspace service (one open workspace: pages, links, search, history, automation) and the typed API between the app's window and it. Runs in a Node worker on desktop and in a Web Worker on Android.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./log": "./src/log.ts",
    "./service": "./src/service.ts",
    "./automation": "./src/automation.ts",
    "./app-config": "./src/app-config.ts",
    "./config-folder": "./src/config-folder.ts",
    "./globals": "./src/globals.ts",
    "./relations": "./src/relations.ts",
    "./templates": "./src/templates.ts",
    "./workspace-file": "./src/workspace-file.ts",
    "./web-worker-core": "./src/web-worker-core.ts",
    "./web-host": "./src/web-host.ts",
    "./web-protocol": "./src/web-protocol.ts",
    "./fs-rpc": "./src/fs-rpc.ts",
    "./web-worker": "./src/web-worker.ts",
    "./build/worker-options": "./build/worker-options.mjs",
    "./settings": "./src/settings.ts",
    "./workspaces": "./src/workspaces.ts",
    "./scan": "./src/scan.ts"
  },
  "imports": {
    "#watcher": {
      "browser": "./src/watcher-none.ts",
      "default": "./src/watcher.ts"
    }
  },
  "dependencies": {
    "@cave-notes/core-automation": "0.1.0",
    "@cave-notes/core-export": "0.1.0",
    "@cave-notes/core-index": "0.1.0",
    "@cave-notes/core-links": "0.1.0",
    "@cave-notes/core-md": "0.1.0",
    "@cave-notes/core-sync": "0.1.0",
    "@cave-notes/core-tree": "0.1.0",
    "@cave-notes/platform": "0.1.0",
    "@sqlite.org/sqlite-wasm": "*",
    "chokidar": "*",
    "yaml": "*"
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "*",
    "vitest": "*"
  }
}
